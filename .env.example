# Safe placeholders only. Secrets are stored in AWS Secrets Manager, never here.
AWS_REGION=us-east-1
APP_ENV=development
COCKROACH_SECRET_ID=replace-with-aws-secret-id
COCKROACH_MCP_SECRET_ID=replace-with-aws-secret-id
