{
  "name": "decivanta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  },
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build": "node node_modules/esbuild/bin/esbuild src/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js && node node_modules/next/dist/bin/next build apps/web",
    "build:api": "node node_modules/esbuild/bin/esbuild src/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "build:web": "node node_modules/next/dist/bin/next build apps/web",
    "db:migrate-seed": "tsx scripts/migrate-seed.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p packages/contracts/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "validate:sam": "sam validate --lint --template-file infrastructure/template.yaml"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1110.0",
    "@aws-sdk/client-lambda": "3.1110.0",
    "@aws-sdk/client-secrets-manager": "3.1110.0",
    "@aws-sdk/credential-providers": "3.1110.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "eslint": "9.39.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "3.2.7"
  }
}
