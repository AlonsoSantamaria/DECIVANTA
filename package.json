{
  "name": "decivanta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "db:migrate-seed": "tsx scripts/migrate-seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1110.0",
    "@aws-sdk/client-lambda": "^3.1110.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/credential-providers": "^3.1110.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pg": "^8.16.3",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
